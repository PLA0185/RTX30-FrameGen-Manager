<!--
    深色主题。

    界面用 DynamicResource 查找这些键，切换主题时整个字典被替换，
    WPF 会重新解析所有引用——不需要重建窗口。

    为什么必须是 DynamicResource 而不是 StaticResource：
    StaticResource 在元素创建时解析一次，之后不再查表，所以切换主题
    会让大部分界面停留在旧颜色上。

    键按用途命名，不按颜色命名，这样浅色主题能用完全不同的色值表达
    同一语义。

    配色方向：石墨分层（窗体 < 面板 < 卡片）+ RTX 绿强调。强调色只用于
    主操作与选中态，避免到处高亮等于没有高亮。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 窗口与容器：三层底色拉开层次 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0C0E11" />
    <SolidColorBrush x:Key="PanelBackground" Color="#14171C" />
    <SolidColorBrush x:Key="CardBackground" Color="#191D23" />
    <SolidColorBrush x:Key="LogBackground" Color="#0A0C0E" />
    <SolidColorBrush x:Key="PopupBackground" Color="#161A20" />

    <!-- 输入控件：比面板更深一档，形成内凹感 -->
    <SolidColorBrush x:Key="InputBackground" Color="#0F1216" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#272D36" />

    <!-- 分隔线与悬停 -->
    <SolidColorBrush x:Key="LineBrush" Color="#1F242B" />
    <SolidColorBrush x:Key="HoverBackground" Color="#21262E" />
    <SolidColorBrush x:Key="ListHoverBackground" Color="#191E25" />
    <SolidColorBrush x:Key="ListSelectedBackground" Color="#1F2B21" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E9ECEF" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA4AF" />
    <SolidColorBrush x:Key="TextFaint" Color="#75808B" />
    <SolidColorBrush x:Key="TextSection" Color="#B4BDC6" />
    <SolidColorBrush x:Key="TextLogTitle" Color="#D2D8DE" />
    <SolidColorBrush x:Key="TextOnLog" Color="#B0B8C0" />

    <!-- 强调色与按钮：RTX 绿，主按钮黑字保证对比度 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#76B900" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#1B2027" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2C333C" />
    <SolidColorBrush x:Key="PrimaryBackground" Color="#76B900" />
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#76B900" />
    <SolidColorBrush x:Key="PrimaryHoverBackground" Color="#84CB0D" />
    <SolidColorBrush x:Key="OnPrimaryText" Color="#0C0F0A" />
    <SolidColorBrush x:Key="DangerBackground" Color="#301A1C" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#5E3134" />
    <SolidColorBrush x:Key="DangerText" Color="#F0959A" />

    <!-- 徽章 -->
    <SolidColorBrush x:Key="BadgeOkBackground" Color="#1D3421" />
    <SolidColorBrush x:Key="BadgeOkText" Color="#8FD96C" />
    <SolidColorBrush x:Key="BadgeWarnBackground" Color="#362B10" />
    <SolidColorBrush x:Key="BadgeWarnText" Color="#EFC65C" />

    <!-- 反作弊警告横幅 -->
    <SolidColorBrush x:Key="WarnBannerBackground" Color="#2D230E" />
    <SolidColorBrush x:Key="WarnBannerBorder" Color="#6B5316" />
    <SolidColorBrush x:Key="WarnBannerTitle" Color="#F2C94C" />
    <SolidColorBrush x:Key="WarnBannerBody" Color="#DCC687" />

    <!-- 游戏状态指示 -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#71D57E" />
    <SolidColorBrush x:Key="StatusWarnBrush" Color="#EFC65C" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#F0959A" />
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#5C6670" />

    <!--
        没有隐式样式的控件会落回 WPF 内置模板，而内置模板的前景色来自系统主题、不参与本字典。
        ToolTip / ListBox / Expander / ToggleButton 都属于这一类：导航栏、工具栏与列表上的提示文字
        因此会在深色界面上渲染成黑字。这里给它们与其余控件同源的最小样式。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
    </Style>

    <!-- 默认模板给 ListBox 的是浅色底，在深色界面上会整块发白 -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

</ResourceDictionary>
